{
  "name": "blazor-guid-generator",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "sync:bootstrap": "node scripts/sync-bootstrap.mjs",
    "build": "pnpm run sync:bootstrap && ./build.sh",
    "build:cloudflare": "pnpm run build && pnpm --dir cloudflare exec cf build",
    "build:cloudflare:prebuilt": "pnpm --dir cloudflare exec cf build",
    "deploy": "pnpm run build:cloudflare && pnpm --dir cloudflare exec cf deploy --prebuilt"
  },
  "devDependencies": {
    "bootstrap": "5.3.9"
  }
}
